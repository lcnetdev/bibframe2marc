    <bf:title>
      <bf:Title>
	<bf:mainTitle xml:lang="ru-latn">[Ulozhenīe gosudari︠a︡ t︠s︡ari︠a︡ Aleksi︠e︡i︠a︡ Mikhailovicha]</bf:mainTitle>
	<bf:mainTitle xml:lang="ru-cyrl">Уложеніе государя царя Алексѣя Михаиловича</bf:mainTitle>
      </bf:Title>
    </bf:title>
    <bf:extent>
      <bf:Extent>
	<rdfs:label>[1], 1-338 leaves</rdfs:label>
      </bf:Extent>
    </bf:extent>
